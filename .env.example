# Copy this file to .env, then adjust the values for this machine.
# System environment variables take precedence over values in .env.

# Separation backends
KTV_SEPARATOR_BACKEND=demucs
KTV_SEPARATOR_STEMS=4
KTV_DEMUCS_CACHE_DIR=D:\OpenKTV\models\demucs
KTV_DEMUCS_MODEL=htdemucs_ft
KTV_UVR_MODEL_DIR=D:\OpenKTV\models\uvr
KTV_UVR_MODEL=UVR-MDX-NET-Voc_FT.onnx
KTV_DEVICE=auto

# Alignment stack
KTV_WHISPER_MODEL=large-v3
KTV_WHISPER_COMPUTE_TYPE=auto
# Leave blank to auto-detect song language.
KTV_WHISPER_LANGUAGE=
KTV_ALIGNMENT_BACKEND=ctc
# Pseudo-spatial mix (backing track only; vocals remain center)
KTV_PSEUDO_DELAY_MS=12
KTV_PSEUDO_REFLECTION_GAIN=0.12
KTV_PSEUDO_REVERB_ROOM=0.45
KTV_PSEUDO_REVERB_DAMPING=0.35
KTV_PSEUDO_BACKING_GAIN=0.9

# Playback/queue behavior
KTV_INTRO_SKIP_LEAD_SECONDS=5
KTV_DOWNLOAD_RETRY_COUNT=2

# Application paths (uncomment only when you want a non-default location)
# KTV_SONGS_DIR=D:\OpenKTV\songs
# KTV_TEMP_DIR=D:\OpenKTV\temp
# KTV_FFMPEG_DIR=C:\path\to\ffmpeg\bin
# KTV_LIBRARY_INDEX_PATH=D:\OpenKTV\songs\library_index.csv

# Server
KTV_HOST=0.0.0.0
KTV_PORT=5000
KTV_SECRET_KEY=replace-with-a-long-random-value

# Spotify Web API (Client Credentials flow). Keep secrets in the OS environment.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
KTV_SPOTIFY_MATCH_THRESHOLD=0.72

# Optional Musixmatch lyrics fallback.
MUSIXMATCH_API_KEY=

# Flask job API token must match KTV_PROCESSING_API_TOKEN for the Node service.
KTV_JOB_API_TOKEN=replace-with-a-long-random-service-token
KTV_PROCESSING_API_TOKEN=replace-with-a-long-random-service-token
KTV_PROCESSING_API_URL=http://127.0.0.1:5000/api/jobs

# Node playback and browser deployment.
KTV_NODE_HOST=0.0.0.0
KTV_NODE_PORT=3000
KTV_SONGS_DIR=./ktv_songs
KTV_LIBRARY_CSV=./ktv_songs/library.csv
PUBLIC_BASE_URL=https://ktv.example.com
# Set a separate token if Flask actively calls the protected Node reload endpoint.
KTV_LIBRARY_RELOAD_TOKEN=replace-with-a-long-random-reload-token
# Comma-separated trusted browser origins; same-origin is sufficient behind one HTTPS host.
KTV_CORS_ORIGINS=
