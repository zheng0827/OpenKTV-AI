# Copy this file to .env, then adjust the values for this machine.
# System environment variables take precedence over values in .env.

# Demucs model/cache
KTV_DEMUCS_CACHE_DIR=D:\OpenKTV\models\demucs
KTV_DEMUCS_MODEL=htdemucs_ft
KTV_SEPARATOR_STEMS=4
KTV_DEVICE=auto

# Pseudo-spatial mix (backing track only; vocals remain center)
KTV_MIX_MODE=pseudo-spatial
KTV_PSEUDO_DELAY_MS=12
KTV_PSEUDO_REFLECTION_GAIN=0.12
KTV_PSEUDO_REVERB_ROOM=0.45
KTV_PSEUDO_REVERB_DAMPING=0.35
KTV_PSEUDO_BACKING_GAIN=0.9

# Lyrics alignment pipeline (faster-whisper + forced alignment worker)
KTV_WHISPER_MODEL=large-v3
KTV_WHISPER_COMPUTE_TYPE=auto
KTV_WHISPER_LANGUAGE=zh
# Use separate whisperx environment python when needed.
# If left empty, pipeline will auto-detect .venv-whisperx / venv-whisperx.
# KTV_ALIGNMENT_PYTHON=D:\\OpenKTV\\.venv-whisperx\\Scripts\\python.exe

# Playback/queue behavior
KTV_INTRO_SKIP_LEAD_SECONDS=5
KTV_DOWNLOAD_RETRY_COUNT=2

# Application paths (uncomment only when you want a non-default location)
# KTV_SONGS_DIR=D:\OpenKTV\songs
# KTV_TEMP_DIR=D:\OpenKTV\temp
# KTV_FFMPEG_DIR=C:\path\to\ffmpeg\bin
# KTV_LIBRARY_INDEX_PATH=D:\OpenKTV\songs\library_index.csv

# Server
KTV_HOST=0.0.0.0
KTV_PORT=5000
KTV_SECRET_KEY=replace-with-a-long-random-value
