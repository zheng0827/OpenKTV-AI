# Copy this file to .env, then adjust the values for this machine.
# System environment variables take precedence over values in .env.

# Separation backends
KTV_SEPARATOR_BACKEND=demucs
KTV_SEPARATOR_STEMS=4
KTV_DEMUCS_CACHE_DIR=D:\OpenKTV\models\demucs
KTV_DEMUCS_MODEL=htdemucs_ft
KTV_UVR_MODEL_DIR=D:\OpenKTV\models\uvr
KTV_UVR_MODEL=UVR-MDX-NET-Voc_FT.onnx
KTV_DEVICE=auto

# Alignment stack
KTV_WHISPER_MODEL=large-v3
KTV_WHISPER_COMPUTE_TYPE=auto
# Leave blank to auto-detect song language.
KTV_WHISPER_LANGUAGE=
KTV_ALIGNMENT_BACKEND=ctc
# Pseudo-spatial mix (backing track only; vocals remain center)
KTV_PSEUDO_DELAY_MS=12
KTV_PSEUDO_REFLECTION_GAIN=0.12
KTV_PSEUDO_REVERB_ROOM=0.45
KTV_PSEUDO_REVERB_DAMPING=0.35
KTV_PSEUDO_BACKING_GAIN=0.9

# Playback/queue behavior
KTV_INTRO_SKIP_LEAD_SECONDS=5
KTV_DOWNLOAD_RETRY_COUNT=2
KTV_NODE_PORT=3000
# Optional HTTPS endpoint for mobile microphone access (mobile getUserMedia requires a trusted HTTPS origin).
# KTV_HTTPS_PORT=3443
# KTV_TLS_CERT_PATH=certs/lan.crt
# KTV_TLS_KEY_PATH=certs/lan.key
# Optional ICE/TURN configuration for networks where direct WebRTC connectivity is unavailable.
# KTV_STUN_URLS=stun:stun.l.google.com:19302
# KTV_TURN_URLS=turn:turn.example.com:3478
# KTV_TURN_USERNAME=
# KTV_TURN_CREDENTIAL=

# Discord bot (run with `npm --prefix app run bot`)
# Create a bot application and invite it with applications.commands and bot permissions.
# Generate one random token and use the same value for KTV_BOT_API_TOKEN here and for the Node server.
# KTV_BOT_API_TOKEN=
# Optional: protect sensitive Socket control events (next/replay/seek/reorder/player_command).
# KTV_ROOM_ADMIN_TOKEN=
# Required for server-signed socket role sessions.
# KTV_SOCKET_SESSION_SECRET=replace-with-another-long-random-value
# Optional overrides for playback state restore and audit trail.
# KTV_PLAYBACK_STATE_PATH=logs/playback-state.json
# KTV_AUDIT_LOG_PATH=logs/audit.log
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_GUILD_ID=
# KTV_BOT_API_URL=http://127.0.0.1:3000
# KTV_PYTHON=python
# DISCORD_ACTIVITY_CLIENT_ID=
# DISCORD_ACTIVITY_CLIENT_SECRET=
# DISCORD_ACTIVITY_APPLICATION_ID=
# DISCORD_ACTIVITY_ALLOWED_REDIRECT_ORIGINS=https://your-activity-host.example.com
# DISCORD_ACTIVITY_AUTH_CHALLENGE_TTL_MS=300000

# Optional YouTube-title enrichment and Spotify track metadata
# GEMINI_API_KEY enables AI title/artist extraction; heuristic parsing remains available without it.
# GEMINI_MODEL=gemini-2.5-flash
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Application paths (uncomment only when you want a non-default location)
# KTV_SONGS_DIR=D:\OpenKTV\songs
# KTV_TEMP_DIR=D:\OpenKTV\temp
# KTV_FFMPEG_DIR=C:\path\to\ffmpeg\bin
# KTV_LIBRARY_INDEX_PATH=D:\OpenKTV\songs\library_index.csv

# Server
KTV_HOST=0.0.0.0
KTV_PORT=5000
KTV_SECRET_KEY=replace-with-a-long-random-value
# If deployed behind reverse proxy/load balancer, set trust proxy (e.g. true, 1, loopback).
# KTV_TRUST_PROXY=true
